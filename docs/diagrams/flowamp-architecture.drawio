                    <mxGeometry y="140" width="600" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s3bd" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="s3lg" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s3dd" value="&lt;div&gt;&lt;b&gt;Invoke the agent&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;api-handler Lambda calls InvokeHarness on the AgentCore harness.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="s3lg" vertex="1">
                    <mxGeometry x="52" width="548" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="s4lg" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="210" width="600" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s4bd" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="s4lg" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4dd" value="&lt;div&gt;&lt;b&gt;Resolve via MCP tools&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The agent calls its AgentCore Gateway, which exposes each agent-handler read operation as an MCP tool and invokes the Lambda.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="s4lg" vertex="1">
                    <mxGeometry x="52" width="548" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="s5lg" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="280" width="600" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s5bd" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="s5lg" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s5dd" value="&lt;div&gt;&lt;b&gt;Read the data spine&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;agent-handler reads the single DynamoDB table (agents + compliance/aop/access records).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="s5lg" vertex="1">
                    <mxGeometry x="52" width="548" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="s6lg" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry x="-2" y="344" width="600" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s6bd" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="s6lg" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s6dd" value="&lt;div&gt;&lt;b&gt;Discover agents wherever they run&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;discovery-handler pulls agent records and signals from each source (Bedrock AgentCore, and external platforms like Microsoft / Okta / MuleSoft) - on demand via /discovery/sync and every 6h via EventBridge - and upserts normalized records into DynamoDB. It never sits in an agent request path.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="s6lg" vertex="1">
                    <mxGeometry x="52" width="548" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="s7lg" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="430" width="600" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s7bd" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="s7lg" vertex="1">
